# Copy to .github/workflows/weekly-status.yml to enable. Produces a DRAFT only - a human approves later.
# Add repo secrets: JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN (and ANTHROPIC_API_KEY if you use --live).
# Status: UNTESTED template.
name: weekly-status-draft
on:
  schedule:
    - cron: "0 7 * * 1"   # Mondays 07:00 UTC
  workflow_dispatch:
jobs:
  draft:
    runs-on: ubuntu-latest
    env:
      JIRA_BASE_URL: ${{ secrets.JIRA_BASE_URL }}
      JIRA_EMAIL: ${{ secrets.JIRA_EMAIL }}
      JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: python -m modules.m01_status_agent.run --jira-jql 'project = ABC AND sprint in openSprints()' --export out/jira.csv
      - run: python -m modules.m01_status_agent.run --input out/jira.csv --as-of "$(date +%F)" --program "My Program"
      - uses: actions/upload-artifact@v4
        with: { name: status-draft, path: out/ }
