# Copy to .github/workflows/status-draft.yml to enable.
# Produces a DRAFT and emails ONLY the approver. A person approves and publishes (see SETUP.md section 7).
# Repo secrets to add: JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN, STAKEHOLDERS_JSON (the contents of
# config/stakeholders.json), SMTP_HOST, SMTP_FROM, SMTP_USER, SMTP_PASSWORD (and ANTHROPIC_API_KEY for --live).
# GitHub schedules run in UTC and can start a few minutes late: 06:30 UTC is 07:30 or 08:30 in Stockholm.
# Status: UNTESTED template.
name: status-draft
on:
  schedule:
    - cron: "30 6 * * 1-5"   # weekdays 06:30 UTC; use "30 6 * * 1" for weekly
  workflow_dispatch:
jobs:
  draft:
    runs-on: ubuntu-latest
    env:
      JIRA_BASE_URL: ${{ secrets.JIRA_BASE_URL }}
      JIRA_EMAIL: ${{ secrets.JIRA_EMAIL }}
      JIRA_API_TOKEN: ${{ secrets.JIRA_API_TOKEN }}
      SMTP_HOST: ${{ secrets.SMTP_HOST }}
      SMTP_FROM: ${{ secrets.SMTP_FROM }}
      SMTP_USER: ${{ secrets.SMTP_USER }}
      SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
      JIRA_JQL: "project = ABC AND sprint in openSprints()"
      PROGRAM_NAME: "My Program"
      SEND_EMAIL: "1"
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - name: Write stakeholder config (never committed)
        env:
          STAKEHOLDERS_JSON: ${{ secrets.STAKEHOLDERS_JSON }}
        run: mkdir -p config && printf '%s' "$STAKEHOLDERS_JSON" > config/stakeholders.json
      - name: Draft and email the approver
        run: modules/m01_status_agent/run_scheduled.sh
      - uses: actions/upload-artifact@v4
        with: { name: status-draft, path: out/ }
